<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zygj.hotel.mapper.RoomTypeMapper">
    
    <resultMap type="RoomType" id="RoomTypeResult">
        <result property="id"    column="id"    />
        <result property="typeName"    column="type_name"    />
        <result property="image"    column="image"    />
        <result property="capacity"    column="capacity"    />
        <result property="area"    column="area"    />
        <result property="hasWindow"    column="has_window"    />
        <result property="midnightPrice"    column="midnight_price"    />
        <result property="standardPrice"    column="standard_price"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectRoomTypeVo">
        select id, type_name, image, capacity, area, has_window, midnight_price, standard_price, status, create_by, create_time, update_by, update_time, remark from room_type
    </sql>

    <select id="selectRoomTypeList" parameterType="RoomType" resultMap="RoomTypeResult">
        <include refid="selectRoomTypeVo"/>
        <where>  
            <if test="typeName != null  and typeName != ''"> and type_name like concat('%', #{typeName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectRoomTypeById" parameterType="Long" resultMap="RoomTypeResult">
        <include refid="selectRoomTypeVo"/>
        where id = #{id}
    </select>

    <insert id="insertRoomType" parameterType="RoomType" useGeneratedKeys="true" keyProperty="id">
        insert into room_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="hotelId != null">hotel_id,</if>
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="image != null">image,</if>
            <if test="capacity != null">capacity,</if>
            <if test="area != null">area,</if>
            <if test="hasWindow != null">has_window,</if>
            <if test="midnightPrice != null">midnight_price,</if>
            <if test="standardPrice != null">standard_price,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="hotelId != null">#{hotelId},</if>
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="image != null">#{image},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="area != null">#{area},</if>
            <if test="hasWindow != null">#{hasWindow},</if>
            <if test="midnightPrice != null">#{midnightPrice},</if>
            <if test="standardPrice != null">#{standardPrice},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateRoomType" parameterType="RoomType">
        update room_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="hotelId != null">hotel_id = #{hotelId},</if>
            <if test="typeName != null and typeName != ''">type_name = #{typeName},</if>
            <if test="image != null">image = #{image},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="area != null">area = #{area},</if>
            <if test="hasWindow != null">has_window = #{hasWindow},</if>
            <if test="midnightPrice != null">midnight_price = #{midnightPrice},</if>
            <if test="standardPrice != null">standard_price = #{standardPrice},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRoomTypeById" parameterType="Long">
        delete from room_type where id = #{id}
    </delete>

    <delete id="deleteRoomTypeByIds" parameterType="String">
        delete from room_type where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>